# Copy this file to ".env" in the project folder (or set these in your terminal).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
COMPANY_NAME=Indomer Coastal Hydraulics (P) Ltd
# Big brand text in the header / login page (full name above is shown small under it)
COMPANY_SHORT_NAME=Indomer

# ---- Database ----
# sqlite (default) or postgres
DB_ENGINE=sqlite
# Only needed when DB_ENGINE=postgres
DB_NAME=hr_portal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Neon / hosted PostgreSQL (optional) ----
# If you set DATABASE_URL, it is used instead of everything above.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Holidays / WhatsApp (v6) ---
WEEKLY_OFF_DAYS=6
# link = free click-to-chat buttons on the Notifications page.  cloud = automatic (needs the two values below)
WHATSAPP_MODE=link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_DEFAULT_COUNTRY=91
